<script>
  function updateServerClock() {
    const now = new Date();
    
    // Opsi Zona Waktu (Asia/Jayapura = WIT, Asia/Makassar = WITA, Asia/Jakarta = WIB)
    const timeOptions = {
      timeZone: 'Asia/Jayapura',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    };

    const dateOptions = {
      timeZone: 'Asia/Jayapura',
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    };

    const timeFormatter = new Intl.DateTimeFormat('id-ID', timeOptions);
    const dateFormatter = new Intl.DateTimeFormat('id-ID', dateOptions);

    document.getElementById('server-clock').textContent = timeFormatter.format(now).replace(/\./g, ':');
    document.getElementById('server-date').textContent = dateFormatter.format(now);
  }

  // Perbarui jam setiap 1 detik
  setInterval(updateServerClock, 1000);
  updateServerClock();
</script>

