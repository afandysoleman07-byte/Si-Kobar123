  <!-- JAVASCRIPT LOGIC -->
  <script>
    var globalPatrolData = { headers: [], rows: [] };
    var chartInstance = null;

    // INISIALISASI SAAT HALAMAN DIMUAT
    window.onload = function() {
      startLiveClock();
      loadDashboardData();
    };

    // FUNGSI GANTI TAB
    function switchTab(tab) {
      var tabs = ['dashboard', 'tabel', 'monitoring', 'laporan', 'pengaturan'];
      var titles = {
        'dashboard': 'Dashboard Patroli',
        'tabel': 'Tabel Data Patroli',
        'monitoring': 'Monitoring Petugas',
        'laporan': 'Laporan & Ekspor',
        'pengaturan': 'Pengaturan & Sistem'
      };

      tabs.forEach(function(t) {
        var sec = document.getElementById('sec-' + t);
        var nav = document.getElementById('nav-' + t);
        if (sec) sec.classList.add('hidden');
        if (nav) {
          nav.classList.remove('bg-emerald-600', 'text-white');
          nav.classList.add('text-slate-400', 'hover:bg-slate-800');
        }
      });

      var activeSec = document.getElementById('sec-' + tab);
      var activeNav = document.getElementById('nav-' + tab);
      if (activeSec) activeSec.classList.remove('hidden');
      if (activeNav) {
        activeNav.classList.add('bg-emerald-600', 'text-white');
        activeNav.classList.remove('text-slate-400', 'hover:bg-slate-800');
      }

      document.getElementById('pageTitle').innerText = titles[tab] || 'SI-KOBAR Dashboard';
    }

    // FUNGSI AMBIL DATA DARI BACKEND
    function loadDashboardData() {
      var refreshIcon = document.getElementById('refreshIcon');
      if (refreshIcon) refreshIcon.classList.add('fa-spin');

      google.script.run
        .withSuccessHandler(function(summary) {
          if (refreshIcon) refreshIcon.classList.remove('fa-spin');
          
          // Update Ringkasan Statistik
          document.getElementById('statTotalPatroli').innerText = summary.totalPatroli || 0;
          document.getElementById('statKondisiAman').innerText = summary.statusKondisi.Aman || 0;
          document.getElementById('statKondisiWaspada').innerText = summary.statusKondisi.Waspada || 0;
          document.getElementById('statTotalPetugas').innerText = summary.totalPetugas || 0;

          // Alert jika ada Waspada / Bahaya
          if (summary.statusKondisi.Waspada > 0 || summary.statusKondisi.Bahaya > 0) {
            document.getElementById('alertBanner').classList.remove('hidden');
            document.getElementById('alertText').innerText = 'Terdeteksi ' + summary.statusKondisi.Waspada + ' catatan kondisi khusus/waspada pada laporan patroli.';
          } else {
            document.getElementById('alertBanner').classList.add('hidden');
          }

          // Update Log Terakhir
          renderRecentLogs(summary.recentLogs);

          // Update Grafik
          renderChart(summary.harianChart);

          // Update Petugas
          renderPetugasCards(summary.petugasList);

          // Muat Tabel Data Utama
          loadTableData();
        })
        .withFailureHandler(function(err) {
          if (refreshIcon) refreshIcon.classList.remove('fa-spin');
          console.error("Gagal memuat summary:", err);
        })
        .getDashboardSummary();
    }

    // FUNGSI AMBIL KESELURUHAN TABEL DATA
    function loadTableData() {
      google.script.run
        .withSuccessHandler(function(dataObj) {
          globalPatrolData = dataObj;
          renderTableData(dataObj);
        })
        .getPatrolData();
    }

    // RENDER TABEL DINAMIS SESUAI KOLOM SPREADSHEET
    function renderTableData(dataObj) {
      var thead = document.getElementById('tableHeader');
      var tbody = document.getElementById('tableBody');
      var countLabel = document.getElementById('recordCount');

      if (!dataObj || !dataObj.headers || dataObj.headers.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center py-6 text-slate-400">Tidak ada data patroli ditemukan.</td></tr>';
        countLabel.innerText = '0 Data';
        return;
      }

      var headers = dataObj.headers;
      var rows = dataObj.rows;

      // 1. Render Dynamic Header
      var headerHtml = '<tr>';
      headers.forEach(function(h) {
        headerHtml += '<th class="px-4 py-3 whitespace-nowrap">' + h + '</th>';
      });
      headerHtml += '</tr>';
      thead.innerHTML = headerHtml;

      // Cari indeks kolom STATUS / KONDISI secara cerdas
      var idxStatus = headers.findIndex(function(h) { return /status|kondisi/i.test(h); });

      // 2. Render Dynamic Rows
      if (rows.length === 0) {
        tbody.innerHTML = '<tr><td colspan="' + headers.length + '" class="text-center py-6 text-slate-400">Belum ada baris data.</td></tr>';
        countLabel.innerText = '0 Data';
        return;
      }

      var bodyHtml = '';
      rows.slice().reverse().forEach(function(row) {
        bodyHtml += '<tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition border-b border-slate-100 dark:border-slate-700/40">';
        
        row.forEach(function(cell, idx) {
          var val = (cell !== null && cell !== undefined) ? cell.toString() : '';
          
          if (idx === idxStatus) {
            // Badge Format untuk Kolom STATUS
            var badgeClass = 'bg-emerald-500/10 text-emerald-600 border-emerald-500/20';
            if (val.toLowerCase().indexOf('waspada') !== -1) {
              badgeClass = 'bg-amber-500/10 text-amber-600 border-amber-500/20';
            } else if (val.toLowerCase().indexOf('bahaya') !== -1) {
              badgeClass = 'bg-rose-500/10 text-rose-600 border-rose-500/20';
            }
            bodyHtml += '<td class="px-4 py-3 whitespace-nowrap"><span class="px-2.5 py-1 rounded-full text-[11px] font-bold border ' + badgeClass + '">' + val + '</span></td>';
          } else {
            bodyHtml += '<td class="px-4 py-3 whitespace-nowrap text-slate-700 dark:text-slate-200">' + val + '</td>';
          }
        });

        bodyHtml += '</tr>';
      });

      tbody.innerHTML = bodyHtml;
      countLabel.innerText = rows.length + ' Data Ditemukan';
    }

    // FUNGSI FILTER TABEL
    function filterTable() {
      var query = document.getElementById('searchInput').value.toLowerCase();
      var filterKondisi = document.getElementById('filterKondisi').value.toLowerCase();

      if (!globalPatrolData || !globalPatrolData.rows) return;

      var headers = globalPatrolData.headers;
      var idxStatus = headers.findIndex(function(h) { return /status|kondisi/i.test(h); });

      var filteredRows = globalPatrolData.rows.filter(function(row) {
        var matchQuery = row.some(function(cell) {
          return cell && cell.toString().toLowerCase().indexOf(query) !== -1;
        });

        var matchKondisi = true;
        if (filterKondisi !== 'all' && idxStatus !== -1) {
          var statusVal = (row[idxStatus] || '').toString().toLowerCase();
          matchKondisi = statusVal.indexOf(filterKondisi) !== -1;
        }

        return matchQuery && matchKondisi;
      });

      renderTableData({ headers: headers, rows: filteredRows });
    }

    // RENDER LOG TERAKHIR
    function renderRecentLogs(logs) {
      var container = document.getElementById('recentLogContainer');
      if (!logs || logs.length === 0) {
        container.innerHTML = '<p class="text-xs text-slate-400">Belum ada catatan.</p>';
        return;
      }

      var html = '';
      logs.forEach(function(r) {
        var waktu = r[1] || r[0] || '-';
        var petugas = r[2] || 'Petugas';
        var lokasi = r[4] || 'Lokasi';
        var status = r[5] || 'Aman';

        html += '<div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-700/40 border border-slate-100 dark:border-slate-700/50 flex items-center justify-between text-xs">' +
                  '<div>' +
                    '<p class="font-semibold text-slate-700 dark:text-slate-200">' + lokasi + '</p>' +
                    '<p class="text-[11px] text-slate-400">' + petugas + ' • ' + waktu + '</p>' +
                  '</div>' +
                  '<span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">' + status + '</span>' +
                '</div>';
      });

      container.innerHTML = html;
    }

    // RENDER GRAFIK
    function renderChart(harianData) {
      var ctx = document.getElementById('chartPatroli').getContext('2d');
      var labels = Object.keys(harianData || {});
      var values = Object.values(harianData || {});

      if (chartInstance) chartInstance.destroy();

      chartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels.length ? labels : ['Hari Ini'],
          datasets: [{
            label: 'Jumlah Kontrol Patroli',
            data: values.length ? values : [0],
            borderColor: '#16a34a',
            backgroundColor: 'rgba(22, 163, 74, 0.1)',
            fill: true,
            tension: 0.35,
            borderWidth: 2,
            pointRadius: 4,
            pointBackgroundColor: '#16a34a'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, ticks: { precision: 0 } }
          }
        }
      });
    }

    // RENDER MONITORING PETUGAS
    function renderPetugasCards(petugasMap) {
      var container = document.getElementById('petugasContainer');
      if (!petugasMap || Object.keys(petugasMap).length === 0) {
        container.innerHTML = '<p class="text-xs text-slate-400">Tidak ada data petugas.</p>';
        return;
      }

      var html = '';
      Object.keys(petugasMap).forEach(function(nama) {
        var item = petugasMap[nama];
        html += '<div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-700/40 border border-slate-200/60 dark:border-slate-700/60 flex items-center gap-3">' +
                  '<div class="w-10 h-10 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-sm shadow-md">' +
                    nama.charAt(0) +
                  '</div>' +
                  '<div>' +
                    '<h4 class="font-bold text-xs text-slate-800 dark:text-slate-100">' + nama + '</h4>' +
                    '<p class="text-[11px] text-slate-400">Regu: ' + (item.regu || '-') + ' • Total Patroli: <span class="font-semibold text-emerald-600 dark:text-emerald-400">' + item.total + 'x</span></p>' +
                    '<p class="text-[10px] text-slate-400 mt-0.5"><i class="fa-regular fa-clock mr-1"></i>Terakhir: ' + (item.terakhirPatroli || '-') + '</p>' +
                  '</div>' +
                '</div>';
      });

      container.innerHTML = html;
    }

    // UTILITIES
    function toggleSidebar() {
      var sb = document.getElementById('sidebar');
      sb.classList.toggle('-ml-64');
    }

    function toggleDarkMode() {
      document.documentElement.classList.toggle('dark');
    }

    function refreshAllData() {
      loadDashboardData();
    }

    function startLiveClock() {
      setInterval(function() {
        var now = new Date();
        
        // Mengambil jam, menit, dan detik secara langsung dari waktu lokal perangkat
        var jam = String(now.getHours()).padStart(2, '0');
        var menit = String(now.getMinutes()).padStart(2, '0');
        var detik = String(now.getSeconds()).padStart(2, '0');
        
        // Menampilkan waktu dengan format HH:MM:SS
        document.getElementById('liveClock').innerText = jam + ':' + menit + ':' + detik + ' WIT';
      }, 1000);
    }
  </script>
</body>
